# Salin ke .env lalu isi (jangan commit .env!)
# NVIDIA NIM API key — dari https://build.nvidia.com → Get API Key
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model NIM (optional, default deepseek-ai/deepseek-v4-flash-0731)
# Catatan: model reasoning (mis. stepfun-ai/step-3.7-flash) nggak didukung — output di message.reasoning, bukan content.
NIM_MODEL=deepseek-ai/deepseek-v4-flash-0731
